<link rel="stylesheet" href="/tools/simple-page.css?v=20260529">

<div class="guilds-page guild-edit-page">
  <section class="guild-edit-panel">
    <span>Danger zone</span>
    <h1>Delete Guild</h1>
    <p>This action will remove the guild and cannot be undone.</p>

    <div class="guild-confirm-box">
      Are you sure you want to delete guild <b>{{ guild.getName() }}</b>?
    </div>

    <form action="?subtopic=guilds&guild={{ guild.getName()|url_encode }}&action=delete_guild" method="post">
      <input type="hidden" name="todo" value="save">
      <div class="guild-form-actions">
        <button class="guild-button guild-button-danger" type="submit">Yes, Delete</button>
        <a class="guild-button guild-button-danger" href="{{ getLink('guilds') ~ '/' ~ guild.getName()|url_encode }}">Back</a>
      </div>
    </form>
  </section>
</div>
