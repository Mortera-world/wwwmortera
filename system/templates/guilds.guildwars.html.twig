<link rel="stylesheet" href="tools/simple-page.css">

<div class="guilds-page guild-edit-page">
  {% if isLeader %}
    <section class="guild-edit-panel">
      <span>Declarations</span>
      <h1>Declarations of War</h1>
      <p>Review pending war requests for {{ guild_name }}.</p>

      <div class="guild-war-list">
        {% set pending = false %}
        {% for war in wars %}
          {% if war.statusid == '1' %}
            {% set pending = true %}
            <article class="guild-war-card">
              <div>
                <h3><a href="?guilds/{{ war.name }}">{{ war.name }}</a></h3>
                <div class="guild-war-meta">
                  <span>Status: {{ war.status }}</span>
                  <span>{{ war.duration }} days</span>
                  <span>{{ war.kills }} kills</span>
                  <span>{{ war.price }} gold</span>
                </div>
              </div>
              <div class="guild-form-actions">
                <form method="post" action="">
                  <input type="hidden" name="war_acpt" value="{{ war.id }}">
                  <button class="guild-button guild-button-compact" type="submit">Accept War</button>
                </form>
                <form method="post" action="">
                  <input type="hidden" name="war_rej" value="{{ war.id }}">
                  <button class="guild-button guild-button-danger guild-button-compact" type="submit">Reject War</button>
                </form>
              </div>
            </article>
          {% endif %}
        {% endfor %}

        {% if not pending %}
          <div class="guild-empty-message">{{ guild_name }} is currently without war requests.</div>
        {% endif %}
      </div>

      <div class="guild-form-actions">
        <a class="guild-button" href="?subtopic=guilds&guild={{ guild_name|url_encode }}&action=guildwars_declare">Declare War</a>
      </div>
    </section>
  {% endif %}

  <section class="guild-edit-panel">
    <span>Active wars</span>
    <h1>Guild Wars</h1>
    <p>Current wars involving {{ guild_name }}.</p>

    <div class="guild-war-list">
      {% set active = false %}
      {% for war in wars %}
        {% if war.statusid == '2' %}
          {% set active = true %}
          <article class="guild-war-card">
            <div>
              <h3><a href="?guilds/{{ war.name }}">{{ war.name }}</a></h3>
              <div class="guild-war-meta">
                <span>{{ war.duration }} days</span>
                <span>{{ war.kills }} kills to win</span>
                <span>{{ war.price }} gold</span>
              </div>
            </div>
            <strong>0 x 0</strong>
          </article>
        {% endif %}
      {% endfor %}

      {% if not active %}
        <div class="guild-empty-message">{{ guild_name }} is currently not involved in a guild war.</div>
      {% endif %}
    </div>
  </section>

  <section class="guild-edit-panel">
    <span>History</span>
    <h1>Guild War History</h1>
    <p>Finished and rejected wars are shown here.</p>

    <div class="guild-war-list">
      {% set history = false %}
      {% for war in wars %}
        {% if war.statusid == '3' or war.statusid == '4' %}
          {% set history = true %}
          <article class="guild-war-card">
            <div>
              <h3><a href="?guilds/{{ war.name }}">{{ war.name }}</a></h3>
              <div class="guild-war-meta">
                <span>Status: {{ war.status }}</span>
                <span>{{ war.duration }} days</span>
                <span>{{ war.kills }} kills</span>
                <span>{{ war.price }} gold</span>
              </div>
            </div>
            <strong>0 x 0</strong>
          </article>
        {% endif %}
      {% endfor %}

      {% if not history %}
        <div class="guild-empty-message">{{ guild_name }} has never participated in a guild war.</div>
      {% endif %}
    </div>
  </section>

  <div class="guild-form-actions guild-form-actions-center">
    <a class="guild-button guild-button-danger" href="{{ getLink('guilds') ~ '/' ~ guild_name|url_encode }}">Back</a>
  </div>
</div>
