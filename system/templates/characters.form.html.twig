<link rel="stylesheet" href="/tools/simple-page.css?v=20260531">

<section class="characters-search-panel">
  <div>
    <span>Character Search</span>
    <h1>Search Character</h1>
    <p>Escribe el nombre del personaje para abrir su informacion.</p>
  </div>

  <form class="characters-search-form" action="{{ link }}" method="post">
    <label>
      <span>Character Name</span>
      <input name="name" value="" size="29" maxlength="29"{% if autofocus %} autofocus{% endif %} autocomplete="off">
    </label>
    <button class="characters-blue-button" type="submit">Submit</button>
  </form>
</section>
