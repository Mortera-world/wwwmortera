<link rel="stylesheet" href="/tools/simple-page.css?v=20260531">

<div class="account-form-page">
  <section class="account-form-hero">
    <span>Recovery Key</span>
    <h1>Buy New Recovery Key</h1>
    <p>Genera una nueva recovery key para tu cuenta. La nueva key reemplaza a la anterior y se muestra una sola vez.</p>
  </section>

  {% if generated_recovery_key %}
    <section class="account-form-card recovery-key-result-card">
      <div class="account-form-card-heading">
        <span>Generated</span>
        <h2>New recovery key</h2>
        <p>Guarda esta key ahora. Al salir o recargar esta pagina ya no se volvera a mostrar.</p>
      </div>

      <div class="recovery-key-result">{{ generated_recovery_key }}</div>
      <div class="account-form-actions">
        <a class="account-form-button account-form-button-blue" href="{{ getLink('account/manage') }}">Back to Account</a>
      </div>
    </section>
  {% endif %}

  {% if show_form %}
    <section class="account-form-card">
      <div class="account-form-card-heading">
        <span>Confirm</span>
        <h2>Confirm purchase</h2>
        <p>
          New recovery key cost:
          <b style="color: {{ color }}">{{ need_coins }} {{ coin_name }}</b>.
          Your balance: <b>{{ coins }} {{ coin_name }}</b>.
        </p>
      </div>

      <form action="{{ getLink('account/register/new') }}" method="post">
        <input type="hidden" name="registeraccountsave" value="1">
        <div class="account-form-fields">
          <label>
            Account password
            <input type="password" name="reg_password" maxlength="64" required>
          </label>
        </div>

        <div class="account-form-actions">
          <button class="account-form-button account-form-button-green" type="submit">Generate Key</button>
          <a class="account-form-button account-form-button-red" href="{{ getLink('account/manage') }}">Back</a>
        </div>
      </form>
    </section>
  {% endif %}
</div>
