<link rel="stylesheet" href="/tools/simple-page.css?v=20260531">

<div class="guilds-page guild-edit-page">
  <form class="guild-edit-panel" action="?subtopic=guilds&guild={{ guild.getName()|url_encode }}&action=pass_leadership" method="post">
    <span>Leadership</span>
    <h1>Pass Leadership</h1>
    <p>Transfer ownership to another character from this guild.</p>

    <input type="hidden" name="todo" value="save">

    <label class="guild-field" style="margin-top: 12px;">
      <span>New leader</span>
      <input type="text" name="player" placeholder="Character name" autocomplete="off">
    </label>

    <div class="guild-form-actions">
      <button class="guild-button" type="submit">Submit</button>
      <a class="guild-button guild-button-danger" href="{{ getLink('guilds') ~ '/' ~ guild.getName()|url_encode }}">Back</a>
    </div>
  </form>
</div>
