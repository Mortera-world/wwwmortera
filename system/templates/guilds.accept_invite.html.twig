<link rel="stylesheet" href="/tools/simple-page.css?v=20260531">

<div class="guilds-page guild-edit-page">
  <form class="guild-edit-panel" action="?subtopic=guilds&action=accept_invite&guild={{ guild_name|url_encode }}&todo=save" method="post">
    <span>Guild invitation</span>
    <h1>Accept Invitation</h1>
    <p>Select the character that will join this guild.</p>

    <div class="guild-radio-list">
      {% for player in invited_players %}
        <label class="guild-radio-option">
          <input type="radio" name="name" value="{{ player }}"{% if loop.first %} checked{% endif %}>
          {{ player }}
        </label>
      {% endfor %}
    </div>

    <div class="guild-form-actions">
      <button class="guild-button" type="submit">Submit</button>
      <a class="guild-button guild-button-danger" href="{{ getLink('guilds') ~ '/' ~ guild_name|url_encode }}">Back</a>
    </div>
  </form>
</div>
