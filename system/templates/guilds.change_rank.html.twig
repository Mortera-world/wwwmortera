<link rel="stylesheet" href="/tools/simple-page.css?v=20260529">

<div class="guilds-page guild-edit-page">
  {% if notice is defined and notice %}
    <div class="guild-edit-alert">{{ notice|raw }}</div>
  {% endif %}

  <form class="guild-edit-panel" action="?subtopic=guilds&action=change_rank&guild={{ guild_name|url_encode }}&todo=save" method="post">
    <span>Member rank</span>
    <h1>Change Rank</h1>
    <p>Select a member and assign a new guild rank.</p>

    <div class="guild-field-grid">
      <label class="guild-field">
        <span>Name</span>
        <select name="name">
          {% for player in players %}
            <option value="{{ player[0] }}">{{ player[1] }}</option>
          {% endfor %}
        </select>
      </label>

      <label class="guild-field">
        <span>Rank</span>
        <select name="rankid">
          {% for rank in ranks %}
            <option value="{{ rank[0] }}">{{ rank[1] }}</option>
          {% endfor %}
        </select>
      </label>
    </div>

    <div class="guild-form-actions">
      <button class="guild-button" type="submit">Submit</button>
      <a class="guild-button guild-button-danger" href="{{ getLink('guilds') ~ '/' ~ guild_name|url_encode }}">Back</a>
    </div>
  </form>
</div>
