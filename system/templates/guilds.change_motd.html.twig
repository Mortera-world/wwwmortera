<link rel="stylesheet" href="/tools/simple-page.css?v=20260531">

<div class="guilds-page guild-edit-page">
  {% if saved is defined and saved %}
    <div class="guild-edit-alert">Changes have been saved.</div>
  {% endif %}

  <form class="guild-edit-panel" enctype="multipart/form-data" action="?subtopic=guilds&guild={{ guild.getName()|url_encode }}&action=change_motd" method="post">
    <span>Message board</span>
    <h1>Change Guild MOTD</h1>
    <p>Set the message of the day shown in game for guild members.</p>

    <input type="hidden" name="todo" value="save">

    <label class="guild-field" style="margin-top: 12px;">
      <span>MOTD</span>
      <textarea name="motd" rows="5">{{ guild.getCustomField('motd')|raw }}</textarea>
      <small>Max. {{ config.guild_motd_chars_limit }} characters.</small>
    </label>

    <div class="guild-form-actions">
      <button class="guild-button" type="submit">Save MOTD</button>
      <a class="guild-button guild-button-danger" href="{{ getLink('guilds') ~ '/' ~ guild.getName()|url_encode }}">Back</a>
    </div>
  </form>
</div>
