<link rel="stylesheet" href="/tools/simple-page.css?v=20260531">

<div class="guilds-page guild-edit-page">
  <form class="guild-edit-panel" action="?subtopic=guilds&guild={{ guild_name|url_encode }}&action=guildwars_declare" method="post">
    <span>Guild war</span>
    <h1>Declare War</h1>
    <p>Send a war declaration to another guild.</p>

    <div class="guild-field-grid">
      <label class="guild-field">
        <span>Opponent</span>
        <select name="war_opp">
          <option>(select opponent)</option>
          {% for guild in guilds %}
            <option value="{{ guild.id }}">{{ guild.name }}</option>
          {% endfor %}
        </select>
      </label>

      <label class="guild-field">
        <span>Duration</span>
        <input type="number" name="war_days" min="7" max="180">
        <small>Between 7 and 180 days.</small>
      </label>

      <label class="guild-field">
        <span>Kills to win</span>
        <input type="number" name="war_kills" min="10" max="1000">
        <small>Between 10 and 1000 kills.</small>
      </label>

      <label class="guild-field">
        <span>Price</span>
        <input type="number" name="war_price" max="2000000000">
        <small>Between 0 and 2,000,000,000 gold.</small>
      </label>
    </div>

    <label class="guild-field" style="margin-top: 12px;">
      <span>Comment</span>
      <textarea rows="8" name="war_comment"></textarea>
    </label>

    <input type="hidden" name="war_st" value="save">

    <div class="guild-form-actions">
      <button class="guild-button" type="submit">Declare War</button>
      <a class="guild-button guild-button-danger" href="{{ getLink('guilds') ~ '/' ~ guild_name|url_encode }}">Back</a>
    </div>
  </form>
</div>
