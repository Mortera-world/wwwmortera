<link rel="stylesheet" href="tools/simple-page.css">

<div class="team-page">
  <div class="team-divider"><span></span></div>

  {% for group in groupmember|reverse %}
    {% if group.members is not empty %}
      <section class="team-section">
        <header class="team-section-head">
          <div class="team-section-icon">
            <img src="{{ template_path }}/images/global/content/headline-bracer-left.gif" alt="">
          </div>

          <div class="team-section-title">
            <span>{{ group.meta.kicker }}</span>
            <h2>{{ group.meta.title }}</h2>
            <p>{{ group.meta.description }}</p>
          </div>

          <div class="team-count">{{ group.members|length }} {% if group.members|length == 1 %}member{% else %}members{% endif %}</div>
        </header>

        <div class="team-card-grid">
          {% for member in group.members|reverse %}
            <a class="team-member-card" href="{{ member.character_url }}">
              <div class="team-outfit-frame">
                {% if member.outfit %}
                  <img src="{{ member.outfit }}" alt="{{ member.player_name }}">
                {% endif %}
              </div>

              <strong>{{ member.player_name }}</strong>
              <span class="team-rank">{{ group.meta.title }}</span>

              <small>Last Seen</small>
              <em>{{ member.last_login ?: 'Not connected yet' }}</em>
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}
  {% else %}
    <section class="team-section">
      <h2>Staff Team</h2>
      <p>No staff members are visible right now.</p>
    </section>
  {% endfor %}

  <section class="team-help">
    <strong>Need help?</strong>
    <p>Administrators are available in-game for technical support. For reports and evidence, please use the official support channels.</p>
  </section>
</div>
