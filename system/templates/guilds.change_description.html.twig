<link rel="stylesheet" href="tools/simple-page.css">

<div class="guilds-page guild-edit-page">
  {% if saved is defined and saved %}
    <div class="guild-edit-alert">Changes have been saved.</div>
  {% endif %}

  <form class="guild-edit-panel" enctype="multipart/form-data" action="?subtopic=guilds&guild={{ guild.getName()|url_encode }}&action=change_description" method="post">
    <span>Guild description</span>
    <h1>Change Guild Description</h1>
    <p>This text appears on the guild profile page.</p>

    <input type="hidden" name="todo" value="save">

    <label class="guild-field" style="margin-top: 12px;">
      <span>Description</span>
      <textarea name="description" rows="{{ config.guild_description_lines_limit - 1 }}">{{ guild.getCustomField('description')|raw }}</textarea>
      <small>Max. {{ config.guild_description_lines_limit }} lines and {{ config.guild_description_chars_limit }} characters.</small>
    </label>

    <div class="guild-form-actions">
      <button class="guild-button" type="submit">Save Description</button>
      <a class="guild-button guild-button-danger" href="{{ getLink('guilds') ~ '/' ~ guild.getName()|url_encode }}">Back</a>
    </div>
  </form>
</div>
