<link rel="stylesheet" href="/tools/simple-page.css?v=20260531">

<div class="online-page">
  <section class="online-hero">
    <div>
      <span>Players Online</span>
      <h1>Who is online?</h1>
      <p>Personajes conectados ahora mismo en {{ config.lua.serverName }}.</p>
    </div>
    <strong>{{ players|length }} online</strong>
  </section>

  {% if not status.online and players|length == 0 %}
    <section class="online-empty">
      <h2>Server is offline.</h2>
      <p>{{ config.lua.serverName }} no esta disponible en este momento.</p>
    </section>
  {% else %}
    <section class="online-summary-grid">
      <div class="online-summary-card">
        <span>Status</span>
        <strong>Online</strong>
      </div>
      <div class="online-summary-card">
        <span>Players</span>
        <strong>{{ players|length }}</strong>
      </div>
      {% if record %}
        <div class="online-summary-card">
          <span>Record</span>
          <strong>{{ record|raw }}</strong>
        </div>
      {% endif %}
    </section>

    {% if config.online_vocations %}
      <section class="online-vocations">
        <div class="online-section-head">
          <div>
            <span>Vocations</span>
            <h2>Online status</h2>
          </div>
          <strong>{{ current_date }}</strong>
        </div>

        <div class="online-vocation-grid">
          <div class="online-vocation-card"><span>Sorcerers</span><strong>{{ vocs[1] }}</strong></div>
          <div class="online-vocation-card"><span>Druids</span><strong>{{ vocs[2] }}</strong></div>
          <div class="online-vocation-card"><span>Paladins</span><strong>{{ vocs[3] }}</strong></div>
          <div class="online-vocation-card"><span>Knights</span><strong>{{ vocs[4] }}</strong></div>
        </div>
      </section>
    {% endif %}

    <section class="online-list">
      <div class="online-section-head">
        <div>
          <span>Characters</span>
          <h2>Online players</h2>
        </div>
        <strong>{{ players|length }} total</strong>
      </div>

      {% if players|length == 0 %}
        <div class="online-empty">
          <h2>No players online.</h2>
          <p>Currently no one is playing on {{ config.lua.serverName }}.</p>
        </div>
      {% else %}
        <div class="online-card-grid">
          {% for player in players %}
            <a class="online-card" href="{{ player.url }}">
              <div class="online-outfit">
                {% if config.online_outfit and player.outfit %}
                  <img src="{{ player.outfit }}" alt="{{ player.display_name }}">
                {% else %}
                  <b>{{ player.display_name|slice(0, 1) }}</b>
                {% endif %}
              </div>

              <div class="online-main">
                <h2>{{ player.display_name }}{{ player.skull|raw }}</h2>
                <div class="online-meta">
                  <span>{{ player.vocation }}</span>
                  <span>Level {{ player.level }}</span>
                  {% if config.account_country and player.country_image %}
                    <span class="online-country">{{ player.country_image|raw }}</span>
                  {% endif %}
                </div>
              </div>

              <div class="online-state">
                <span>Status</span>
                <strong>Online</strong>
              </div>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </section>
  {% endif %}
</div>
