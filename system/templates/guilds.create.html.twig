<link rel="stylesheet" href="/tools/simple-page.css?v=20260531">

<div class="guilds-page guild-edit-page">
  {% if errors is defined and errors|length > 0 %}
    <div class="guild-edit-alert guild-edit-alert-error">
      <ul>
        {% for error in errors %}
          <li>{{ error|raw }}</li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  <section class="guilds-hero">
    <div>
      <span>Guild creation</span>
      <h1>Create a {{ config.lua.serverName }} Guild</h1>
      <p>Choose the leader character and the public name for the new guild.</p>
    </div>
    <strong>Create</strong>
  </section>

  <form class="guild-edit-panel" action="?subtopic=guilds&action=create&todo=save" method="post">
    <span>Basic details</span>
    <h2>New Guild</h2>
    <p>The selected leader must be on your account and meet the level requirements.</p>

    <div class="guild-field-grid">
      <label class="guild-field">
        <span>Leader</span>
        <select name="name">
          {% for player in players %}
            <option{% if submitted_name is defined and submitted_name == player %} selected{% endif %}>{{ player }}</option>
          {% endfor %}
        </select>
        <small>Name of the leader of the new guild.</small>
      </label>

      <label class="guild-field">
        <span>Guild name</span>
        <input name="guild" value="{{ submitted_guild_name|default('') }}" maxlength="50" autocomplete="off">
        <small>Write the name of your new guild.</small>
      </label>
    </div>

    <div class="guild-form-actions">
      <button class="guild-button" type="submit">Submit</button>
      <a class="guild-button guild-button-danger" href="?subtopic=guilds">Back</a>
    </div>
  </form>
</div>
