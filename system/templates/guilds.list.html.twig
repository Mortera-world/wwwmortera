<link rel="stylesheet" href="/tools/simple-page.css?v=20260529">

<div class="guilds-page">
  <section class="guilds-hero">
    <div>
      <span>Guild Directory</span>
      <h1>Active Guilds on {{ config.lua.serverName }}</h1>
      <p>Browse the active guilds, check their leaders and members, and open a guild profile for full details.</p>
    </div>
    <strong>{{ guilds|length }} {% if guilds|length == 1 %}guild{% else %}guilds{% endif %}</strong>
  </section>

  {% if guilds|length > 0 %}
    <section class="guilds-grid">
      {% for guild in guilds %}
        <article class="guild-card">
          <div class="guild-logo">
            <img src="images/guilds/{{ guild.logo }}" alt="{{ guild.name }}">
          </div>

          <div class="guild-card-main">
            <h2>{{ guild.name }}</h2>
            <div class="guild-meta">
              <span>{{ guild.member_count }} {% if guild.member_count == 1 %}member{% else %}members{% endif %}</span>
              <span>Leader: {{ guild.leader_name }}</span>
            </div>

            {% if guild.description is not empty %}
              <p>{{ guild.description|striptags|slice(0, 160) }}{% if guild.description|striptags|length > 160 %}...{% endif %}</p>
            {% else %}
              <p>No public description has been added for this guild yet.</p>
            {% endif %}
          </div>

          <div class="guild-card-actions">
            <a class="guild-button guild-button-view" href="{{ guild.link }}">View</a>
            {% if isAdmin %}
              <a class="guild-button guild-button-danger" href="?subtopic=guilds&action=delete_by_admin&guild={{ guild.name|url_encode }}">Delete</a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </section>
  {% else %}
    <section class="guilds-empty">
      <h2>No guilds found</h2>
      <p>There are no guilds on the server yet.</p>
      {% if logged %}
        <form action="?subtopic=guilds&action=create" method="post">
          <button class="guild-button guild-button-view" type="submit">Found Guild</button>
        </form>
      {% endif %}
    </section>
  {% endif %}

  <section class="guilds-footer-panel">
    {% if logged %}
      <div>
        <strong>No guild found that suits your needs?</strong>
        <p>Create a new guild and invite your team.</p>
      </div>
      <form action="?subtopic=guilds&action=create" method="post">
        <button class="guild-button guild-button-view" type="submit">Found Guild</button>
      </form>
    {% else %}
      <div>
        <strong>Before you can create a guild you must login.</strong>
        <p>Log in to create or manage a guild.</p>
      </div>
      <form action="?subtopic=accountmanagement&redirect={{ getLink('guilds') }}" method="post">
        <button class="guild-button guild-button-view" type="submit">Login</button>
      </form>
    {% endif %}
  </section>

  {% if logged %}
    <section class="guilds-tools">
      <a href="?subtopic=guilds&action=cleanup_players">Cleanup players</a>
      <a href="?subtopic=guilds&action=cleanup_guilds">Cleanup guilds</a>
    </section>
  {% endif %}
</div>
