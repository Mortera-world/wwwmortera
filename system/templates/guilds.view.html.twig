<link rel="stylesheet" href="/tools/simple-page.css?v=20260531">

{% set guildOwnerName = guild_owner is not empty ? guild_owner.getName() : 'Unknown' %}
{% set memberTotal = 0 %}
{% for rank in guild_members %}
  {% set memberTotal = memberTotal + rank.members|length %}
{% endfor %}

<div class="guilds-page">
  <section class="guild-view-hero">
    <div class="guild-view-logo">
      <img src="images/guilds/{{ logo }}" alt="{{ guild_name }}">
    </div>

    <div class="guild-view-title">
      <span>Guild Profile</span>
      <h1>{{ guild_name }}</h1>
      <p>{{ memberTotal }} {% if memberTotal == 1 %}member{% else %}members{% endif %} on {{ config.lua.serverName }}</p>
    </div>

    <a class="guild-button guild-button-view" href="{{ getLink('guilds') }}">Back</a>
  </section>

  <section class="guild-view-layout">
    <article class="guild-panel guild-info-panel">
      <span>Guild Information</span>
      <h2>Overview</h2>

      {% if description is not empty %}
        <div class="guild-description">{{ description|raw }}</div>
      {% else %}
        <p>No public description has been added for this guild yet.</p>
      {% endif %}

      <div class="guild-info-grid">
        <div>
          <span>Leader</span>
          <strong><a href="{{ getPlayerLink(guildOwnerName, false) }}">{{ guildOwnerName }}</a></strong>
        </div>
        <div>
          <span>Founded</span>
          <strong>{{ guild_creation_date|date("M d, Y") }}</strong>
        </div>
        <div>
          <span>Bank Balance</span>
          <strong>{{ guild_balance }} gold</strong>
        </div>
        {% if guild_house and isVice %}
          <div>
            <span>Guild House</span>
            <strong>{{ guild_house }}</strong>
          </div>
        {% endif %}
      </div>
    </article>

    <aside class="guild-panel guild-actions-panel">
      <span>Actions</span>
      <h2>Navigation</h2>

      <div class="guild-action-list">
        {% if isLeader %}
          <a class="guild-button guild-button-view" href="?subtopic=guilds&action=manager&guild={{ guild_name|url_encode }}">Edit Ranks</a>
          <a class="guild-button guild-button-view" href="?subtopic=guilds&guild={{ guild_name|url_encode }}&action=change_logo">Change Banner</a>
          <a class="guild-button guild-button-view" href="?subtopic=guilds&guild={{ guild_name|url_encode }}&action=change_description">Edit Description</a>
          {% if constant('MOTD_EXISTS') %}
            <a class="guild-button guild-button-view" href="?subtopic=guilds&guild={{ guild_name|url_encode }}&action=change_motd">Create Board</a>
          {% endif %}
          <a class="guild-button guild-button-danger" href="?subtopic=guilds&guild={{ guild_name|url_encode }}&action=delete_guild">Disband Guild</a>
          <a class="guild-button guild-button-view" href="?subtopic=guilds&guild={{ guild_name|url_encode }}&action=pass_leadership">Resign Leadership</a>
        {% endif %}

        {% if logged %}
          {% if isVice %}
            <form action="?subtopic=guilds&action=invite&guild={{ guild_name|url_encode }}" method="post">
              <button class="guild-button guild-button-view" type="submit">Invite Character</button>
            </form>
            <form action="?subtopic=guilds&action=change_rank&guild={{ guild_name|url_encode }}" method="post">
              <button class="guild-button guild-button-view" type="submit">Edit Members</button>
            </form>
          {% endif %}

          {% if show_accept_invite > 0 %}
            <form action="?subtopic=guilds&action=accept_invite&guild={{ guild_name|url_encode }}" method="post">
              <button class="guild-button guild-button-view" type="submit">Accept Guild</button>
            </form>
          {% endif %}

          {% if players_from_account_in_guild|length > 0 %}
            <form action="?subtopic=guilds&action=leave_guild&guild={{ guild_name|url_encode }}" method="post">
              <button class="guild-button guild-button-danger" type="submit">Leave Guild</button>
            </form>
          {% endif %}
        {% else %}
          <form action="?subtopic=accountmanagement&redirect={{ getGuildLink(guild_name|url_encode, false) }}" method="post">
            <button class="guild-button guild-button-view" type="submit">Login</button>
          </form>
        {% endif %}
      </div>
    </aside>
  </section>

  <section class="guild-panel">
    <span>Guild Members</span>
    <h2>Roster</h2>

    <div class="guild-rank-list">
      {% for rank in guild_members if rank.members|length > 0 %}
        <article class="guild-rank-card">
          <header>
            <strong>{{ rank.rank_name }}</strong>
            <span>{{ rank.members|length }} {% if rank.members|length == 1 %}member{% else %}members{% endif %}</span>
          </header>

          <div class="guild-member-list">
            {% for player in rank.members %}
              {% set playerName = player.getName() %}
              {% set showGuildNick = useGuildNick and player.getGuildNick() is not empty %}
              <div class="guild-member-row">
                <div>
                  <strong>{{ getPlayerLink(playerName, true)|raw }}</strong>
                  {% if showGuildNick %}
                    <small>{{ player.getGuildNick()|raw }}</small>
                  {% endif %}
                </div>

                <div class="guild-member-meta">
                  <span>{{ player.getVocationName() }}</span>
                  <span>Level {{ player.getLevel() }}</span>
                  <b class="{% if player.isOnline() %}is-online{% else %}is-offline{% endif %}">{% if player.isOnline() %}Online{% else %}Offline{% endif %}</b>
                </div>

                {% if logged and player.getId() in players_from_account_ids %}
                  <form class="guild-nick-form" action="?subtopic=guilds&action=change_nick&name={{ playerName|url_encode }}&guild={{ guild_name|url_encode }}" method="post">
                    <input type="text" name="nick" value="{% if showGuildNick %}{{ player.getGuildNick() }}{% endif %}" placeholder="Guild title">
                    <button type="submit">Change</button>
                  </form>
                {% endif %}

                {% if logged and (level_in_guild > rank.rank_level or isLeader) and guildOwnerName != playerName %}
                  <a class="guild-mini-action" href="?subtopic=guilds&action=kick_player&guild={{ guild_name|url_encode }}&name={{ playerName|url_encode }}">Kick</a>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        </article>
      {% else %}
        <div class="guild-empty-message">No guild members found.</div>
      {% endfor %}
    </div>
  </section>

  <section class="guild-panel">
    <span>Invited Characters</span>
    <h2>Pending Invites</h2>

    <div class="guild-invites-list">
      {% for invited_player in invited_list if invited_list|length > 0 and invited_player.isLoaded() %}
        <div class="guild-invite-row">
          <strong>{{ getPlayerLink(invited_player.getName(), true)|raw }}</strong>
          {% if isVice %}
            <a class="guild-mini-action" href="?subtopic=guilds&action=delete_invite&guild={{ guild_name|url_encode }}&name={{ invited_player.getName()|url_encode }}">Cancel Invitation</a>
          {% endif %}
        </div>
      {% else %}
        <div class="guild-empty-message">No invited characters found.</div>
      {% endfor %}
    </div>
  </section>
</div>
