<link rel="stylesheet" href="tools/simple-page.css">

<div class="guilds-page guild-edit-page">
  <form class="guild-edit-panel" action="?subtopic=guilds&action=leave_guild&guild={{ guild_name|url_encode }}&todo=save" method="post">
    <span>Leave guild</span>
    <h1>Leave Guild</h1>
    <p>Select which character will leave this guild.</p>

    {% if players|length > 0 %}
      <div class="guild-radio-list">
        {% for player in players %}
          <label class="guild-radio-option">
            <input type="radio" name="name" value="{{ player }}"{% if loop.first %} checked{% endif %}>
            {{ player }}
          </label>
        {% endfor %}
      </div>
    {% else %}
      <div class="guild-empty-message">None of your characters can leave this guild.</div>
    {% endif %}

    <div class="guild-form-actions">
      {% if players|length > 0 %}
        <button class="guild-button guild-button-danger" type="submit">Leave Guild</button>
      {% endif %}
      <a class="guild-button guild-button-danger" href="{{ getLink('guilds') ~ '/' ~ guild_name|url_encode }}">Back</a>
    </div>
  </form>
</div>
