<link rel="stylesheet" href="tools/simple-page.css">

<div class="guilds-page guild-edit-page">
  <section class="guild-edit-panel">
    <span>Invitation</span>
    <h1>Delete Player Invitation</h1>
    <p>Remove this character from the guild invitation list.</p>

    <div class="guild-confirm-box">
      Are you sure you want to delete player <b>{{ player_name }}</b> from the invites list?
    </div>

    <form action="?subtopic=guilds&action=delete_invite&guild={{ guild_name|url_encode }}&name={{ player_name|url_encode }}&todo=save" method="post">
      <div class="guild-form-actions">
        <button class="guild-button guild-button-danger" type="submit">Submit</button>
        <a class="guild-button guild-button-danger" href="{{ getLink('guilds') ~ '/' ~ guild_name|url_encode }}">Back</a>
      </div>
    </form>
  </section>
</div>
