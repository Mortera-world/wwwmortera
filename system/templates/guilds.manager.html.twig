<link rel="stylesheet" href="/tools/simple-page.css?v=20260531">

<div class="guilds-page guild-edit-page">
  <section class="guilds-hero">
    <div>
      <span>Guild manager</span>
      <h1>Edit Ranks</h1>
      <p>Manage rank names, permissions level and guild structure for {{ guild.getName() }}.</p>
    </div>
    <strong>{{ rank_list|length }} ranks</strong>
  </section>

  <form class="guild-edit-panel" action="?subtopic=guilds&guild={{ guild.getName()|url_encode }}&action=add_rank" method="post">
    <span>Add rank</span>
    <h2>Create New Rank</h2>
    <p>Add a new guild rank before assigning its level.</p>

    <div class="guild-field-grid">
      <label class="guild-field">
        <span>New rank name</span>
        <input type="text" name="rank_name" autocomplete="off">
      </label>
    </div>

    <div class="guild-form-actions">
      <button class="guild-button" type="submit">Create</button>
      <a class="guild-button guild-button-danger" href="{{ getLink('guilds') ~ '/' ~ guild.getName()|url_encode }}">Back</a>
    </div>
  </form>

  <form class="guild-edit-panel" action="?subtopic=guilds&action=save_ranks&guild={{ guild.getName()|url_encode }}" method="post">
    <span>Rank editor</span>
    <h2>Change Rank Names and Levels</h2>
    <p>Use leader, vice or member level depending on what each rank should be able to manage.</p>

    <div class="guild-rank-editor">
      {% for rank in rank_list %}
        <div class="guild-rank-edit-row">
          <div class="guild-rank-id">ID {{ rank.getId() }}</div>

          <label class="guild-field">
            <span>Name</span>
            <input type="text" name="{{ rank.getId() }}_name" value="{{ rank.getName() }}">
          </label>

          <div class="guild-rank-options">
            <label class="guild-rank-option">
              <input type="radio" name="{{ rank.getId() }}_level" value="3"{% if rank.getLevel() == 3 %} checked{% endif %}>
              <span>Leader</span>
            </label>
            <label class="guild-rank-option">
              <input type="radio" name="{{ rank.getId() }}_level" value="2"{% if rank.getLevel() == 2 %} checked{% endif %}>
              <span>Vice</span>
            </label>
            <label class="guild-rank-option">
              <input type="radio" name="{{ rank.getId() }}_level" value="1"{% if rank.getLevel() == 1 %} checked{% endif %}>
              <span>Member</span>
            </label>
          </div>

          <a class="guild-button guild-button-danger guild-button-compact" href="?subtopic=guilds&guild={{ guild.getName()|url_encode }}&action=delete_rank&rankid={{ rank.getId() }}">Delete</a>
        </div>
      {% endfor %}
    </div>

    <div class="guild-form-actions">
      <button class="guild-button" type="submit">Save All</button>
      <a class="guild-button guild-button-danger" href="{{ getLink('guilds') ~ '/' ~ guild.getName()|url_encode }}">Back</a>
    </div>
  </form>

  <section class="guild-edit-panel">
    <span>Ranks info</span>
    <h2>Permission Guide</h2>
    <ul class="guild-help-list">
      <li><b>Owner</b> is the highest rank and only one character can own the guild.</li>
      <li><b>Leader</b> can invite, cancel invitations, kick players, change ranks, delete the guild and edit the guild profile.</li>
      <li><b>Vice</b> can invite, cancel invitations and change lower-ranked members.</li>
      <li><b>Member</b> is the regular guild member rank.</li>
    </ul>
  </section>
</div>
