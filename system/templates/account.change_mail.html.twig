<link rel="stylesheet" href="/tools/simple-page.css?v=20260531">

<div class="account-form-page">
	<section class="account-form-hero">
		<span>Account Security</span>
		<h1>Change Email</h1>
		<p>Escribe el nuevo correo y confirma el cambio con tu password actual.</p>
	</section>

	<form action="{{ getLink('account/email') }}" method="post" class="account-form-card">
		<div class="account-form-card-heading">
			<span>Email Address</span>
			<h2>Actualizar correo</h2>
			<p>El cambio se finaliza despues de un periodo de espera de {{ config.account_mail_change }} dias por seguridad.</p>
		</div>

		<div class="account-form-fields">
			<label>
				<span>New Email Address</span>
				<input name="new_email" value="{% if new_email is defined %}{{ new_email }}{% endif %}" maxlength="50" autofocus>
			</label>
			<label>
				<span>Password</span>
				<input type="password" name="password" maxlength="29">
			</label>
		</div>

		<div class="account-form-actions">
			<input type="hidden" name="changeemailsave" value="1">
			<button class="account-form-button account-form-button-green" type="submit">Submit</button>
			<a class="account-form-button account-form-button-blue" href="{{ getLink('account/manage') }}">Back</a>
		</div>
	</form>
</div>
