<link rel="stylesheet" href="/tools/simple-page.css?v=20260529">

{% set motd = '' %}
{% if constant('MOTD_EXISTS') %}
  {% set motd = ', MOTD' %}
{% endif %}

<div class="guilds-page guild-edit-page">
  <section class="guild-notice-card">
    <span>Guild created</span>
    <h1>Created guild</h1>
    <p>
      <b>Congratulations!</b> You have created guild <b>{{ guild_name }}</b>.
      <b>{{ leader_name }}</b> is the leader. You can now invite players and edit the banner,
      description{{ motd }}.
    </p>

    <div class="guild-form-actions guild-form-actions-center">
      <form action="{{ getLink('guilds') ~ '/' ~ guild_name|url_encode }}" method="post">
        <button class="guild-button" type="submit">Submit</button>
      </form>
      <form action="{{ getLink('guilds') }}" method="post">
        <button class="guild-button guild-button-danger" type="submit">Back</button>
      </form>
    </div>
  </section>
</div>
