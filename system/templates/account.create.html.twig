{{ hook('HOOK_ACCOUNT_CREATE_BEFORE_FORM') }}
<link rel="stylesheet" href="/tools/simple-page.css?v=20260529">

<form action="{{ getLink('account/create') }}" method="post" id="createaccount" class="create-account-page">
	<section class="create-account-hero">
		<span>New account</span>
		<h1>Create Account</h1>
		<p>Registra tu cuenta para entrar al servidor. Usa datos reales y guarda tu account name y password en un lugar seguro.</p>
	</section>

	<section class="create-account-card">
		<div class="create-account-card-heading">
			<span>Account details</span>
			<h2>Datos de acceso</h2>
			<p>Estos datos seran necesarios para entrar al juego y administrar tu cuenta.</p>
		</div>

		<div class="create-account-fields">
			{{ hook('HOOK_ACCOUNT_CREATE_BEFORE_BOXES') }}
			{{ hook('HOOK_ACCOUNT_CREATE_BEFORE_ACCOUNT') }}

			{% if config.account_login_by_email %}
				<label class="create-account-field">
					<span{% if errors.account is defined %} class="red"{% endif %}>Account {% if constant('USE_ACCOUNT_NAME') %}Name{% else %}Number{% endif %}</span>
					<div class="create-account-input-wrap">
						<input type="text" name="account" id="account_input" maxlength="{% if constant('USE_ACCOUNT_NAME') %}30{% else %}10{% endif %}" value="{{ account }}" />
						<img id="account_indicator" src="images/global/general/{% if not save or errors.account is defined %}n{% endif %}ok.gif" style="display: none;" />
					</div>
					{% if constant('USE_ACCOUNT_NAME') %}
						<small id="SuggestAccountNumber"><a href="#">Suggest number</a></small>
					{% endif %}
					<em id="account_error" class="FormFieldError">{% if errors.account is defined %}{{ errors.account }}{% endif %}</em>
				</label>
			{% endif %}

			{{ hook('HOOK_ACCOUNT_CREATE_AFTER_ACCOUNT') }}

			<label class="create-account-field">
				<span{% if errors.email is defined %} class="red"{% endif %}>Email Address</span>
				<div class="create-account-input-wrap">
					<input type="text" name="email" id="email" maxlength="50" value="{{ email }}" />
					<img id="email_indicator" src="images/global/general/{% if not save or errors.email is defined %}n{% endif %}ok.gif" style="display: none;" />
				</div>
				<em id="email_error" class="FormFieldError">{% if errors.email is defined %}{{ errors.email }}{% endif %}</em>
			</label>

			{% if config.mail_enabled and config.account_mail_verify %}
				<div class="create-account-note">Usa un correo real. Enviaremos un link para confirmar tu cuenta.</div>
			{% endif %}

			{{ hook('HOOK_ACCOUNT_CREATE_AFTER_EMAIL') }}

			{% if config.account_country %}
				<label class="create-account-field">
					<span{% if errors.country[0] is defined %} class="red"{% endif %}>Country</span>
					<div class="create-account-input-wrap">
						<select name="country" id="account_country">
							{% for code, country_ in countries %}
								<option value="{{ code }}"{% if(country is defined and country == code) or (country is null and country_recognized == code) %}selected{% endif %}>{{ country_ }}</option>
							{% endfor %}
						</select>
						<img src="" id="account_country_img"/>
					</div>
					{% if errors.country is defined %}
						<em class="FormFieldError">{{ errors.country }}</em>
					{% endif %}
				</label>
			{% endif %}

			{{ hook('HOOK_ACCOUNT_CREATE_AFTER_COUNTRY') }}

			<label class="create-account-field">
				<span{% if errors.password is defined %} class="red"{% endif %}>Password</span>
				<div class="create-account-input-wrap">
					<input type="password" name="password" id="password" value="" maxlength="29" />
					<img id="password_indicator" src="images/global/general/{% if not save or errors.password is defined %}n{% endif %}ok.gif" style="display: none;" />
				</div>
				<em id="password_error" class="FormFieldError">{% if errors.password is defined %}{{ errors.password }}{% endif %}</em>
			</label>

			<label class="create-account-field">
				<span{% if errors.password is defined %} class="red"{% endif %}>Repeat Password</span>
				<div class="create-account-input-wrap">
					<input type="password" name="password2" id="password2" value="" maxlength="29" />
					<img id="password2_indicator" src="images/global/general/{% if not save or errors.password is defined %}n{% endif %}ok.gif" style="display: none;" />
				</div>
				<em id="password2_error" class="FormFieldError">{% if errors.password is defined %}{{ errors.password }}{% endif %}</em>
			</label>

			{{ hook('HOOK_ACCOUNT_CREATE_AFTER_PASSWORDS') }}

			{% if config.recaptcha_enabled %}
				<div class="create-account-field create-account-recaptcha">
					<span{% if errors.verification[0] is defined %} class="red"{% endif %}>Verification</span>
					<div class="g-recaptcha" data-sitekey="{{ config.recaptcha_site_key }}" data-theme="{{ config.recaptcha_theme }}"></div>
					{% if errors.verification is defined %}
						<em class="FormFieldError">{{ errors.verification }}</em>
					{% endif %}
				</div>
			{% endif %}

			{{ hook('HOOK_ACCOUNT_CREATE_AFTER_RECAPTCHA') }}
		</div>
	</section>

	{{ hook('HOOK_ACCOUNT_CREATE_BETWEEN_BOXES_1') }}

	{% if (not config.mail_enabled or not config.account_mail_verify) and config.account_create_character_create %}
		<section class="create-account-card">
			<div class="create-account-card-heading">
				<span>First character</span>
				<h2>Crear personaje</h2>
				<p>Elige el nombre y las opciones iniciales de tu primer personaje.</p>
			</div>

			<div class="create-account-fields">
				{{ hook('HOOK_ACCOUNT_CREATE_BEFORE_CHARACTER_NAME') }}

				<label class="create-account-field">
					<span{% if errors.name is defined %} class="red"{% endif %}>Character Name</span>
					<div class="create-account-input-wrap">
						<input id="character_name" name="name" maxlength="{{ config.character_name_max_length }}" value="{{ name }}"/>
						<img id="character_indicator" src="images/global/general/{% if not save or errors.name is defined %}n{% endif %}ok.gif" style="display: none;" />
					</div>
					<em id="character_error" class="FormFieldError">{% if errors.name is defined %}{{ errors.name }}{% endif %}</em>
				</label>

				{{ hook('HOOK_ACCOUNT_CREATE_AFTER_CHARACTER_NAME') }}

				<div class="create-account-field">
					<span{% if errors.sex is defined %} class="red"{% endif %}>Sex</span>
					<div class="create-account-options">
						{% set i = 0 %}
						{% for id, gender in config.genders|reverse(true) %}
							{% set i = i + 1 %}
							<label>
								<input type="radio" name="sex" id="sex{{ i }}" value="{{ id }}"{% if sex is not null and sex == id %} checked="checked"{% endif %}>
								{{ gender|lower }}
							</label>
						{% endfor %}
					</div>
					<em id="sex_error" class="FormFieldError">{% if errors.sex is defined %}{{ errors.sex }}{% endif %}</em>
				</div>

				{{ hook('HOOK_ACCOUNT_CREATE_AFTER_SEX') }}

				{% if config.character_samples|length > 1 %}
					<div class="create-account-field">
						<span{% if errors.vocation is defined %} class="red"{% endif %}>Vocation</span>
						<div class="create-account-options">
							{% for key, sample_char in config.character_samples %}
								<label>
									<input type="radio" name="vocation" id="vocation{{ key }}" value="{{ key }}"{% if vocation is not null and vocation == key %} checked="checked"{% endif %}>
									{{ config['vocations'][key] }}
								</label>
							{% endfor %}
						</div>
						<em id="vocation_error" class="FormFieldError">{% if errors.vocation is defined %}{{ errors.vocation }}{% endif %}</em>
					</div>
				{% endif %}

				{{ hook('HOOK_ACCOUNT_CREATE_AFTER_VOCATION') }}

				{% if config.character_towns|length > 1 %}
					<div class="create-account-field">
						<span{% if errors.town is defined %} class="red"{% endif %}>Select your town</span>
						<div class="create-account-options">
							{% for town_id in config.character_towns %}
								<label>
									<input type="radio" name="town" id="town{{ town_id }}" value="{{ town_id }}"{% if town is not null and town == town_id %} checked="checked"{% endif %}>
									{{ config.towns[town_id] }}
								</label>
							{% endfor %}
						</div>
					</div>
				{% endif %}

				{{ hook('HOOK_ACCOUNT_CREATE_AFTER_TOWNS') }}
			</div>
		</section>
	{% endif %}

	{{ hook('HOOK_ACCOUNT_CREATE_BETWEEN_BOXES_2') }}

	<section class="create-account-card create-account-rules">
		<div class="create-account-card-heading">
			<span>Rules</span>
			<h2>Terminos del servidor</h2>
			<p>Para crear la cuenta necesitas aceptar las reglas del servidor.</p>
		</div>

		<label class="create-account-check">
			<input type="checkbox" id="accept_rules" name="accept_rules" value="true"{% if accept_rules %}checked{% endif %}/>
			<span>I agree to the <a href="?subtopic=rules" target="_blank">{{ config.lua.serverName }} Rules</a>.</span>
		</label>

		{% if errors.accept_rules is defined %}
			<em class="FormFieldError">{{ errors.accept_rules }}</em>
		{% endif %}
	</section>

	{{ hook('HOOK_ACCOUNT_CREATE_AFTER_BOXES') }}
	{{ hook('HOOK_ACCOUNT_CREATE_BEFORE_SUBMIT_BUTTON') }}

	<div class="create-account-submit">
		<input type="hidden" name="save" value="1">
		<button class="create-account-button" type="submit">Create Account</button>
	</div>
</form>

{{ hook('HOOK_ACCOUNT_CREATE_AFTER_FORM') }}
<script type="text/javascript" src="tools/check_name.js"></script>
