<link rel="stylesheet" href="/tools/simple-page.css?v=20260531">

<div class="account-login-page">
	<section class="account-login-hero">
		<span>Account access</span>
		<h1>Login</h1>
		<p>Entra a tu cuenta para administrar personajes, recovery key, compras y configuraciones.</p>
	</section>

	<section class="account-login-layout">
		<form action="{{ getLink('account/manage') }}" method="post" class="account-login-card">
			{% if redirect is not null %}
				<input type="hidden" name="redirect" value="{{ redirect }}" />
			{% endif %}

			<div class="account-login-card-heading">
				<span>Account Login</span>
				<h2>Accede a tu cuenta</h2>
				<p>Usa tu {{ account|lower }} y password para continuar.</p>
			</div>

			<div class="account-login-fields">
				<label class="account-login-field">
					<span{% if error is not null %} class="red"{% endif %}>{{ account_login_by }}</span>
					<input type="text" name="account_login" maxlength="30" autofocus />
				</label>

				<label class="account-login-field">
					<span{% if error is not null %} class="red"{% endif %}>Password</span>
					<input type="password" name="password_login" maxlength="29">
				</label>

				<label class="account-login-remember">
					<input type="checkbox" id="remember_me" name="remember_me" value="true" />
					<span>Remember me</span>
				</label>

				{% if error is not null %}
					<div class="account-login-error FormFieldError">{{ error }}</div>
				{% endif %}
			</div>

			<div class="account-login-actions">
				<button class="account-login-button account-login-button-primary" type="submit">Login</button>
				<a class="account-login-button account-login-button-secondary" href="{{ getLink('account/lost') }}">Lost Account?</a>
			</div>
		</form>

		<aside class="account-login-side">
			<div>
				<span>New player</span>
				<h2>Create Account</h2>
				<p>Si aun no tienes cuenta, crea una nueva y empieza tu aventura en el servidor.</p>
				<a class="account-login-create" href="{{ getLink('account/create') }}">Create Account</a>
			</div>
		</aside>
	</section>
</div>
