<div id="powerfulguilds" class="Box">
	<div class="BorderTitleText"></div>
	<div class="Border_2">
		<div class="Border_3">
			<div class="BoxContent">
				{% if guilds is empty %}
					<div class="PowerfulGuildsEmpty">There are no any guilds to show yet.</div>
				{% else %}
					<div class="PowerfulGuildsGrid">
						{% for guild in guilds %}
							<a class="PowerfulGuildCard" href="{{ guild.link }}">
								<img src="images/guilds/{{ guild.logo }}" width="64" height="64" border="0" alt="{{ guild.name }}"/>
								<span class="PowerfulGuildName">{{ guild.name }}</span>
								<span class="PowerfulGuildKills">{{ guild.frags }} kills</span>
							</a>
						{% endfor %}
					</div>
				{% endif %}
			</div>
		</div>
	</div>
</div>
