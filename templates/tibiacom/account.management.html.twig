<link rel="stylesheet" href="/tools/simple-page.css?v=20260529">

<div class="account-management-page">
  <section class="account-management-hero">
    <span>Account Management</span>
    <h1>{{ welcome_message|raw }}</h1>
    <p>Administra tu cuenta, personajes, seguridad y datos publicos desde un solo lugar.</p>
  </section>

  <section class="account-management-grid account-management-grid-top">
    <article class="account-management-card account-management-status-card">
      <div class="account-management-card-heading">
        <span>Account Status</span>
        <h2>{{ tag }} Status</h2>
        <p>{{ account_expire_time[0] }}{% if account_expire_time[1] %} Puedes activar beneficios desde la tienda.{% endif %}</p>
      </div>

      <div class="account-management-status">
        {% if account_logged.isPremium() %}
          <img src="{{ template_path }}/images/account/account-status_green.gif" title="{{ tag }} Account" alt="{{ tag }} account">
        {% else %}
          <img src="{{ template_path }}/images/account/account-status_red.gif" title="Free Account" alt="free account">
        {% endif %}
        <strong>{{ account_status|raw }}</strong>
      </div>

      <div class="account-management-actions">
        {% if config.gifts_system %}
          <a class="account-management-button account-management-button-green" href="?points">Get Coins</a>
        {% endif %}
        <a class="account-management-button account-management-button-blue" href="?downloadclient">Download Client</a>
        <form action="{{ getLink('account/logout') }}" method="post">
          <button class="account-management-button account-management-button-red" type="submit">Logout</button>
        </form>
      </div>
    </article>

    <article class="account-management-card">
      <div class="account-management-card-heading">
        <span>Quick Actions</span>
        <h2>Seguridad</h2>
        <p>Cambia tus datos sensibles o registra tu cuenta con recovery key.</p>
      </div>

      <div class="account-management-actions account-management-actions-stack">
        <form action="{{ getLink('account/password') }}" method="post">
          <button class="account-management-button account-management-button-blue" type="submit">Change Password</button>
        </form>
        <form action="{{ getLink('account/email') }}" method="post">
          <input type="hidden" name="newemail" value="">
          <input type="hidden" name="newemaildate" value="0">
          <button class="account-management-button account-management-button-blue" type="submit">Change Email</button>
        </form>
        {% if recovery_key is empty %}
          <form action="{{ getLink('account/register') }}" method="post">
            <button class="account-management-button account-management-button-green" type="submit">Register Account</button>
          </form>
        {% endif %}
      </div>
    </article>
  </section>

  {% if recovery_key is empty %}
    <section class="account-management-notice">
      <div>
        <span>Recovery Key</span>
        <strong>Your account is not registered!</strong>
        <p>Registra tu cuenta para obtener una recovery key y mejorar la proteccion de acceso.</p>
      </div>
      <form action="{{ getLink('account/register') }}" method="post">
        <button class="account-management-button account-management-button-green" type="submit">Register Account</button>
      </form>
    </section>
  {% endif %}

  {% if email_request %}
    <section class="account-management-notice account-management-notice-warn">
      <div>
        <span>Email Request</span>
        <strong>Hay un cambio de correo pendiente</strong>
        <p>A request has been submitted to change the email address to <b>{{ email_new }}</b>. After <b>{{ email_new_time|date("j F Y, G:i:s") }}</b> you can accept the new email address.</p>
      </div>
      <form action="{{ getLink('account/email') }}" method="post">
        <button class="account-management-button account-management-button-blue" type="submit">Review</button>
      </form>
    </section>
  {% endif %}

  <section class="account-management-card">
    <div class="account-management-card-heading account-management-heading-row">
      <div>
        <span>Characters</span>
        <h2>Regular Characters</h2>
        <p>Administra tus personajes activos, comentarios y opciones disponibles.</p>
      </div>
      <div class="account-management-actions">
        <form action="{{ getLink('account/character/create') }}" method="post">
          <button class="account-management-button account-management-button-green" type="submit">Create Character</button>
        </form>
        {% if config.account_change_character_name %}
          <form action="{{ getLink('account/character/name') }}" method="post">
            <button class="account-management-button account-management-button-blue" type="submit">Change Name</button>
          </form>
        {% endif %}
        {% if config.account_change_character_sex %}
          <form action="{{ getLink('account/character/sex') }}" method="post">
            <button class="account-management-button account-management-button-blue" type="submit">Change Sex</button>
          </form>
        {% endif %}
      </div>
    </div>

    <div class="account-management-character-list">
      {% set i = 0 %}
      {% for player in players %}
        {% set i = i + 1 %}
        <article class="account-management-character">
          <div class="account-management-character-index">{{ i }}</div>
          <div class="account-management-character-main">
            <a href="{{ getLink('characters/' ~ player.getName()|url_encode) }}">{{ player.getName() }}</a>
            {% if player.isDeleted() %}
              <strong class="account-management-badge account-management-badge-red">Deleted</strong>
            {% endif %}
            {% if player.isMain() %}
              <strong class="account-management-badge">Main</strong>
            {% endif %}
            <p>{{ config.vocations[player.getVocation()] }} - Level {{ player.getLevel() }} - {{ config['lua']['serverName'] }}</p>
          </div>
          <div class="account-management-character-state">
            {% if player.isOnline() %}
              <span class="account-management-online">Online</span>
            {% else %}
              <span class="account-management-offline">Offline</span>
            {% endif %}
          </div>
          <div class="account-management-character-actions">
            {% if not player.isDeleted() %}
              <a class="account-management-mini-button" href="{{ getLink('account/character/comment/' ~ player.getName()|url_encode) }}">Edit</a>
            {% endif %}
            <a class="account-management-mini-button account-management-mini-button-red" href="{{ getLink('account/character/delete') }}">Delete</a>
          </div>
        </article>
      {% else %}
        <div class="account-management-empty">No tienes personajes en esta cuenta.</div>
      {% endfor %}
    </div>
  </section>

  <section class="account-management-grid">
    <article class="account-management-card">
      <div class="account-management-card-heading">
        <span>General Information</span>
        <h2>Datos de cuenta</h2>
        <p>Informacion privada de acceso y estado de la cuenta.</p>
      </div>

      <div class="account-management-info-list">
        <div><span>Account {% if constant('USE_ACCOUNT_NAME') %}Name{% else %}Number{% endif %}</span><strong>{{ account }}</strong></div>
        <div><span>Email Address</span><strong>{{ account_email }}{{ email_change|raw }}</strong></div>
        <div><span>Created</span><strong>{{ account_created|date("M d Y, G:i:s") }}</strong></div>
        <div><span>Last Login</span><strong>{{ account_web_lastlogin|date("M d Y, G:i:s") }}</strong></div>
        <div><span>Account Status</span><strong>{{ account_status|raw }}</strong></div>
        <div><span>Tibia Coins</span><strong>{{ account_coins }} ({{ account_coins_transferable }} transferable)</strong></div>
        <div><span>Tournament Coins</span><strong>{{ tournament_coins }}</strong></div>
        <div><span>Registered</span><strong>{{ account_registered|raw }}</strong></div>
      </div>
    </article>

    <article class="account-management-card">
      <div class="account-management-card-heading account-management-heading-row">
        <div>
          <span>Public Information</span>
          <h2>Datos publicos</h2>
          <p>Informacion visible o administrativa del perfil.</p>
        </div>
        {% if not account_update_info_on_register %}
          <form action="{{ getLink('account/info') }}" method="post">
            <button class="account-management-button account-management-button-blue" type="submit">Edit</button>
          </form>
        {% endif %}
      </div>

      <div class="account-management-info-list">
        <div><span>Real Name</span><strong>{{ account_rlname ?: '-' }}</strong></div>
        <div><span>Address</span><strong>{{ account_location ?: '-' }}</strong></div>
        <div><span>Phone</span><strong>{{ account_phone ?: '-' }}</strong></div>
        {% if account_show_rk and recovery_key is not empty %}
          <div><span>Recovery Key</span><strong>{{ recovery_key }}</strong></div>
        {% endif %}
      </div>
    </article>
  </section>

  <section class="account-management-card">
    <div class="account-management-card-heading">
      <span>Account Logs</span>
      <h2>Actividad reciente</h2>
      <p>Registro de cambios y acciones importantes realizadas en tu cuenta.</p>
    </div>

    <div class="account-management-log-list">
      {% for action in actions %}
        <div class="account-management-log-row">
          <strong>{{ action.action|raw }}</strong>
          <span>{{ action.date|date("d M Y, H:i:s") }}</span>
          <small title="{{ action.ipv6 }}">{{ action.ip }}</small>
        </div>
      {% else %}
        <div class="account-management-empty">No hay logs disponibles.</div>
      {% endfor %}
    </div>
  </section>
</div>
